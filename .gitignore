# See https://git-scm.com/docs/gitignore

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / build
.next/
out/
build/
dist/
coverage/

# ---------------------------------------------------------------------------
# Secrets — never commit real API keys or credentials
# ---------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
**/serviceAccount*.json
**/firebase-adminsdk*.json
**/credentials.json
**/secrets/

# Keep safe templates in the repo
!.env.example
!backend/.env.example

# Python
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs & OS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem

# IDE
.idea/
.vscode/
*.swp
*.swo

# Deploy / tooling
.vercel
*.tsbuildinfo
next-env.d.ts
.cursor/
